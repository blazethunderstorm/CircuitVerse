source "https://rubygems.org"

git_source(:github) { |repo_name| "https://github.com/#{repo_name}.git" }

gem "rails", "~> 8.0.0"
gem "puma", "~> 6.4"
gem "propshaft"               # Propshaft replaces Sprockets
gem "cssbundling-rails"       # CSS bundling
gem "jsbundling-rails"        # JS bundling
gem "vite_rails"              # Vite integration

# Authentication & Authorization
gem "devise"
gem 'devise_saml_authenticatable'
gem "pundit"

# Social/Omniauth
gem "omniauth"
gem "omniauth-facebook"
gem "omniauth-github"
gem "omniauth-gitlab"
gem "omniauth-google-oauth2"
gem "omniauth-microsoft-office365"
gem 'omniauth-rails_csrf_protection'

# Background jobs & caching
gem "sidekiq"
gem "redis", "~> 4.6"
gem "hiredis"
gem "flipper-redis"
gem "flipper-ui"

# Database
gem "pg", "~> 1.6.1"
gem 'strong_migrations'
gem 'rails-data-migrations', github: 'notarize/rails-data-migrations'

# File uploads
gem "carrierwave", "~> 3.0"
gem "image_processing", "~> 1.12"
gem "aws-sdk-s3", "~> 1.176"

# Utilities / features
gem "view_component"
gem "font-awesome-sass", "~> 5.13.1" # Optional; can use via CSS bundling
gem "redcarpet", '~> 3.3', '>= 3.3.4'
gem "turbolinks", "~> 5"
gem "jbuilder", "~> 2.11"
gem "meta-tags"
gem "webpush"
gem "rack-attack"
gem "noticed", "~> 1.6"
gem "oj", "~> 3.15"
gem "http", "~> 4.4"
gem "inline_svg"
gem "friendly_id", "~> 5.5.1"
gem "simple_discussion", github: "CircuitVerse/simple_discussion"
gem "disposable_mail", github: 'CircuitVerse/disposable_email'

# Analytics
gem "ahoy_matey"
gem "i18n-js"

# Pagination
gem "will_paginate", "~> 4.0.1"
gem "will_paginate-bootstrap"

# Misc
gem "observer", "~> 0.1.2"
gem "drb", "~> 2.2"

group :development, :test do
  gem "pry-rails"
  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails"
  gem "faker"
  gem "debug"
  gem "rubocop"
  gem "rubocop-rails", require: false
  gem "rubocop-performance", require: false
  gem "rubocop-rspec", require: false
  gem "coveralls_reborn", "~> 0.29.0", require: false
  gem "erb_lint", require: false
  gem "rbs_rails"
  gem "steep"
  gem 'solargraph-rails', '~> 0.3.1'
end

group :test do
  gem "capybara", "~> 3.39"
  gem "json-schema"
  gem "rspec_junit_formatter"
  gem "shoulda-matchers"
  gem "webmock"
  gem "simplecov"
  gem "simplecov-lcov"
  gem "undercover"
  gem "undercover-checkstyle"
  gem "percy-capybara"
  gem "capybara-playwright-driver"
end

group :development do
  gem "listen", ">= 3.0.5", "< 3.10"
  gem "web-console", ">= 3.3.0"
  gem "rails-erd"
  gem "bundler-audit", "~> 0.9.1"
  gem 'database_consistency', require: false
  gem "lookbook", ">= 2.2.0"
end

# Timezones for Windows
gem "tzinfo-data", platforms: %i[mingw mswin x64_mingw jruby]
